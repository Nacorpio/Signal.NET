<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Library projects ship XML documentation; missing docs on public API (CS1591) fail the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>

    <!--
      Package validation (dotnet pack): checks the package for inconsistencies and, once a baseline exists,
      for breaking changes against the last published version. Set the baseline after the first release:
      <PackageValidationBaselineVersion>0.2.0</PackageValidationBaselineVersion>
    -->
    <EnablePackageValidation>true</EnablePackageValidation>

    <!--
      RS0026/RS0027 forbid several overloads with optional parameters. Our overloads (e.g. ReplyAsync(string, …)
      vs ReplyAsync(OutgoingMessage, …)) differ in their first parameter type, so calls are never ambiguous.
      Binary compatibility of later changes is guarded by the PublicAPI files and package validation instead.
    -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>

  <!-- Every package carries the repository README (shown on nuget.org). -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <!--
    Public API tracking: every public symbol must be listed in PublicAPI.Shipped.txt or PublicAPI.Unshipped.txt.
    New or changed API shows up as a diff in those files during review (RS0016/RS0017 fail the build otherwise).
    The package picks up PublicAPI.*.txt next to each project automatically.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>

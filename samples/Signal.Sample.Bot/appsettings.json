{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning",
      "Signal": "Information"
    }
  },
  "Signal": {
    "BaseUrl": "http://localhost:8080",
    "Mode": "JsonRpc",
    "Accounts": [ "+10000000000" ],
    "MaxConcurrency": 4,
    "VerifyModeOnStartup": true,
    "FailOnModeMismatch": false,
    "Receive": {
      "PollingInterval": "00:00:01",
      "TimeoutSeconds": 1,
      "IgnoreAttachments": false,
      "IgnoreStories": true,
      "SendReadReceipts": false
    },
    "WebSocket": {
      "ReconnectMinDelay": "00:00:01",
      "ReconnectMaxDelay": "00:00:30",
      "KeepAlive": "00:00:20"
    },
    "Http": {
      "Timeout": "00:00:30",
      "RetryCount": 3
    },
    "Commands": {
      "Prefixes": [ "/", "!" ],
      "CaseSensitive": false,
      "RespondToUnknown": true,
      "QuoteReplies": false,
      "EnableHelp": true,
      "Admins": [ "+10000000000" ]
    },
    "AccessControl": {
      "AllowedSenders": [],
      "BlockedSenders": [],
      "IgnoreOwnMessages": true
    },
    "RateLimit": {
      "PermitsPerWindow": 20,
      "Window": "00:01:00"
    }
  }
}

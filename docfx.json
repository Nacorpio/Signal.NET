{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "src",
          "files": [ "**/*.csproj" ]
        }
      ],
      "dest": "api",
      "properties": {
        "Configuration": "Release"
      }
    }
  ],
  "build": {
    "content": [
      { "files": [ "api/**.yml", "api/index.md" ] },
      { "files": [ "index.md", "toc.yml" ] },
      { "files": [ "docs/**.md", "docs/toc.yml" ], "exclude": [ "docs/README.md" ] },
      { "files": [ "ROADMAP.md", "CHANGELOG.md", "CONTRIBUTING.md", "SECURITY.md" ] }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "Signal.NET",
      "_appTitle": "Signal.NET",
      "_appFooter": "Signal.NET is MIT licensed and not affiliated with Signal Messenger LLC.",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/Nacorpio/Signal.NET",
        "branch": "main"
      }
    }
  }
}
